# libfprint from upstream master with the experimental elanmoc2 driver
# (ELAN 04f3:0c4c and related Match-on-Chip sensors) from
# https://github.com/Knyllahsyhn/libfprint-elanmoc2.
#
# Build setup follows the Arch Linux libfprint package. The driver comes
# from the AUR package libfprint-elanmoc2-git by Davide Depau.

pkgname=libfprint-elanmoc2-knyl-git
_pkgname=libfprint
pkgver=1.94.100+0+g0000000
pkgrel=1
pkgdesc="Library for fingerprint readers, with the elanmoc2 driver for ELAN 0C4C"
url="https://github.com/Knyllahsyhn/libfprint-elanmoc2"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
conflicts=(libfprint libfprint-elanmoc2-git)
provides=("libfprint=${pkgver%%+*}" libfprint-2.so)
groups=(fprint)
source=("$_pkgname::git+https://github.com/Knyllahsyhn/libfprint-elanmoc2.git#branch=elanmoc2")
sha256sums=('SKIP')

pkgver() {
  cd $_pkgname
  git describe --tags | sed 's/^v//;s/^V_//;s/_/./g;s/-/+/g'
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson $_pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
